#!/usr/bin/env bash
# Minimal Azure CLI deployment scaffold for focusBreaker
# WARNING: This is a scaffold. Review and run step-by-step.

set -euo pipefail

# Load env if present
if [ -f deployment/parameters.env ]; then
  source deployment/parameters.env
fi

: ${RG_NAME:=$(echo ${RG_NAME:-rg-focusbreaker})}
: ${LOCATION:=${LOCATION:-eastus}}
: ${APP_NAME:=${APP_NAME:-fb-web}}
: ${STORAGE_NAME:=${STORAGE_NAME:-fbstorage$RANDOM}}
: ${SQL_SERVER_NAME:=${SQL_SERVER_NAME:-fbsqlserver$RANDOM}}
: ${SQL_DB_NAME:=${SQL_DB_NAME:-fbsqldb}}

if [ -z "${AZ_SQL_ADMIN_PASSWORD:-}" ]; then
  echo "Please set AZ_SQL_ADMIN_PASSWORD environment variable with a strong password (or use Key Vault)."
  exit 1
fi

echo "Creating resource group $RG_NAME in $LOCATION"
az group create -n "$RG_NAME" -l "$LOCATION"

echo "Creating storage account $STORAGE_NAME"
az storage account create -n "$STORAGE_NAME" -g "$RG_NAME" -l "$LOCATION" --sku Standard_LRS

echo "Creating App Service plan"
az appservice plan create -g "$RG_NAME" -n "${APP_NAME}-plan" --sku B1 --is-linux

echo "Creating Web App"
az webapp create -g "$RG_NAME" -p "${APP_NAME}-plan" -n "$APP_NAME" --runtime "NODE|18-lts"

echo "Creating Application Insights"
az monitor app-insights component create --app "$APP_NAME-ai" -g "$RG_NAME" -l "$LOCATION" --application-type web

echo "Creating SQL server $SQL_SERVER_NAME"
az sql server create -g "$RG_NAME" -n "$SQL_SERVER_NAME" --location "$LOCATION" --admin-user "$SQL_ADMIN" --admin-password "$AZ_SQL_ADMIN_PASSWORD"

echo "Creating SQL database $SQL_DB_NAME"
az sql db create -g "$RG_NAME" -s "$SQL_SERVER_NAME" -n "$SQL_DB_NAME" --service-objective S0

echo "Enable managed identity for Web App"
az webapp identity assign -g "$RG_NAME" -n "$APP_NAME"

echo "Done. Next steps: configure Key Vault, store SQL password as secret, set connection string in App Settings, and deploy application code."
